{
  "info": {
    "_postman_id": "ae5-3-auth-tokens",
    "name": "AE5.3 - Autenticación con Tokens",
    "description": "Pruebas de API con autenticación basada en tokens (Laravel Sanctum)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "1. Login - Obtener Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('token', jsonData.token);",
                  "    pm.test('Token guardado en variables de entorno', function () {",
                  "        pm.expect(jsonData.token).to.exist;",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n  \\\"email\\\": \\\"test@example.com\\\",\\n  \\\"password\\\": \\\"password\\\"\\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "login"]
            }
          }
        },
        {
          "name": "2. Login Fallido (Credenciales Inválidas)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n  \\\"email\\\": \\\"test@example.com\\\",\\n  \\\"password\\\": \\\"password_incorrecto\\\"\\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "login"]
            }
          }
        },
        {
          "name": "3. Obtener Usuario Autenticado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/api/me",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "me"]
            }
          }
        },
        {
          "name": "4. Logout (Revocar Token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/api/logout",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Pruebas de Seguridad",
      "item": [
        {
          "name": "1. GET /api/spots SIN Token (401 Unauthorized)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Respuesta 401 sin token', function () {",
                  "    pm.expect(pm.response.code).to.eql(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/api/spots",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "spots"]
            }
          }
        },
        {
          "name": "2. GET /api/spots CON Token (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Respuesta 200 con token válido', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "});",
                  "pm.test('Respuesta contiene un array data', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('data');",
                  "    pm.expect(jsonData.data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/api/spots",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "spots"]
            }
          }
        },
        {
          "name": "3. GET /api/registros CON Token",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/api/registros",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "registros"]
            }
          }
        }
      ]
    },
    {
      "name": "Operaciones CRUD - Spots",
      "item": [
        {
          "name": "GET - Listar Spots",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/api/spots",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "spots"]
            }
          }
        },
        {
          "name": "POST - Crear Spot",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('spot_id', jsonData.data.id);",
                  "    pm.test('Spot creado correctamente', function () {",
                  "        pm.expect(jsonData.data).to.have.property('id');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n  \\\"nombre\\\": \\\"Plaza Mayor\\\",\\n  \\\"lat\\\": 40.4168,\\n  \\\"lng\\\": -3.7038,\\n  \\\"descripcion\\\": \\\"Spot perfecto para principiantes con buena iluminación\\\",\\n  \\\"nivel\\\": \\\"Principiante\\\"\\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/spots",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "spots"]
            }
          }
        },
        {
          "name": "GET - Ver Spot (por ID)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/api/spots/{{spot_id}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "spots", "{{spot_id}}"]
            }
          }
        },
        {
          "name": "PUT - Actualizar Spot",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\\n  \\\"nombre\\\": \\\"Plaza Mayor Actualizado\\\",\\n  \\\"nivel\\\": \\\"Intermedio\\\"\\n}"
            },
            "url": {
              "raw": "http://localhost:8000/api/spots/{{spot_id}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "spots", "{{spot_id}}"]
            }
          }
        },
        {
          "name": "DELETE - Eliminar Spot",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "http://localhost:8000/api/spots/{{spot_id}}",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["api", "spots", "{{spot_id}}"]
            }
          }
        }
      ]
    },
